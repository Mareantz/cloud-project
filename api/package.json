    "applicationinsights": "^2.9.8",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "azure-functions-core-tools": "^4.0.0",
    "typescript": "^5.5.3"
  }
