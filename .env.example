# ============================================================
#  .env.example  –  copy to .env and fill in real values
#  Never commit .env to source control.
# ============================================================

# ── Frontend (Vite exposes vars prefixed with VITE_) ────────
# Base URL used by the React app to reach the API.
# In local dev the Vite proxy rewrites /api → Azure Functions.
# In Azure Storage Static Website hosting, set this to your Function App base:
#   https://<function-app-name>.azurewebsites.net/api
VITE_API_BASE_URL=http://localhost:7071/api

# ── Azure Functions – runtime ────────────────────────────────
# Points to Azurite (local) or a real Azure Storage account (prod).
AzureWebJobsStorage=UseDevelopmentStorage=true
FUNCTIONS_WORKER_RUNTIME=node

# ── Cosmos DB ────────────────────────────────────────────────
# Local emulator defaults (safe to commit, emulator-only values).
COSMOS_ENDPOINT=https://localhost:8081
# Well-known emulator master key – NOT a real secret.
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw==
COSMOS_DATABASE=restaurant-reviews
COSMOS_CONTAINER_RESTAURANTS=restaurants
COSMOS_CONTAINER_REVIEWS=reviews

# ── Azure Blob Storage ───────────────────────────────────────
# Variable names must match what api/src/shared/blobClient.ts reads.
# Local dev: Azurite emulator via UseDevelopmentStorage=true.
# Production: set to the real Azure Storage connection string.
BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
# Container for restaurant hero/cover photos (existing flow).
BLOB_CONTAINER_NAME=restaurant-photos
# Container for original images uploaded alongside reviews (Phase 1+).
REVIEW_IMAGES_CONTAINER_NAME=review-images

# ── Azure Queue Storage (review image processing) ─────────────
# Queue that triggers thumbnail generation (Phase 2).
# A message is enqueued when a review image is uploaded; the thumbnail
# function dequeues it, generates a 320 px-wide JPEG, and writes
# thumbnailUrl back to the Cosmos DB review document.
# Local dev: Azurite provides the queue automatically.
REVIEW_IMAGES_QUEUE_NAME=review-image-processing
# Container for generated thumbnail images (Phase 2 pipeline).
REVIEW_THUMBNAILS_CONTAINER_NAME=review-thumbnails

# ── Application Insights (Phase 3 / Phase 6) ────────────────
# API-side telemetry – leave blank for local dev.
# In production this is set automatically by the Bicep template.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Frontend telemetry – Vite bakes this value into the JS bundle at build time.
# To enable Application Insights in the deployed frontend, add this as a
# GitHub Actions secret named VITE_APPLICATIONINSIGHTS_CONNECTION_STRING and
# it will be injected automatically by the CI/CD workflow.
# Leave blank to disable frontend telemetry (safe default for local dev).
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Static Web Apps CLI (local integration) ─────────────────
SWA_CLI_APP_LOCATION=frontend
SWA_CLI_API_LOCATION=api
SWA_CLI_OUTPUT_LOCATION=frontend/dist
SWA_CLI_API_PORT=7071
SWA_CLI_PORT=4280

# ── Azure resource names (production deployment) ─────────────
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=auto
AZURE_FUNCTION_APP_NAME=
AZURE_COSMOS_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_NAME=

# ── CI/CD – GitHub Actions secrets (Phase 7) ─────────────────
# These values are NOT used at runtime; they are stored as GitHub
# repository secrets and consumed by .github/workflows/azure-swa.yml.
#
# AZURE_FUNCTION_APP_NAME
#   The standalone Azure Function App name provisioned by Bicep.
#   This is printed by infra/deploy.sh and infra/deploy.ps1.
#
# AZURE_FUNCTIONAPP_PUBLISH_PROFILE
#   The Function App publish profile XML used by GitHub Actions.
#   Obtain with: az functionapp deployment list-publishing-profiles \
#                  --name <your-function-app-name> \
#                  --resource-group <your-resource-group> \
#                  --xml
#
# AZURE_STORAGE_CONNECTION_STRING
#   Connection string for the Storage Account hosting the static website.
#   Obtain with: az storage account show-connection-string \
#                  --name <your-storage-account-name> \
#                  --resource-group <your-resource-group> \
#                  --query connectionString -o tsv
#
# VITE_APPLICATIONINSIGHTS_CONNECTION_STRING  (optional)
#   Frontend Application Insights connection string.
#   The workflow injects this at build time via Vite's env substitution.
#   Leave the GitHub secret blank to disable frontend telemetry.
#
# Add these in GitHub: Settings → Secrets and variables → Actions → New secret
